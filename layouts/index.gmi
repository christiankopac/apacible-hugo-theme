{{- $title := .Params.name | default .Site.Title | plainify }}
# {{ $title }}

{{- with .Site.Params.description }}
{{ . | plainify }}

{{- end -}}
{{- with .Params.bio }}
{{ . | plainify }}

{{- end -}}
{{- if .Content }}
{{ partial "gemini/content.gmi" . }}

{{- end -}}
{{- with .Site.Params.sections }}
## Explore
{{ range . }}
  {{- if .is_external -}}
{{ printf "=> %s %s\n" .path .name -}}
  {{- else -}}
    {{- $page := $.Site.GetPage .path -}}
    {{- if $page -}}
      {{- $link := $page.RelPermalink -}}
      {{- with $page.OutputFormats.Get "Gemini" -}}
        {{- $link = .RelPermalink -}}
      {{- end -}}
{{ printf "=> %s %s\n" $link .name -}}
    {{- else -}}
{{ printf "=> %s %s\n" .path .name -}}
    {{- end -}}
  {{- end -}}
{{- end }}
{{- printf "\n" -}}
{{- end -}}

{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $webURL = printf "%s%s" .Site.BaseURL .RelPermalink -}}
{{- end -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
=> {{ $webURL }} Web version

