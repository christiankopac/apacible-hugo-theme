{{- $title := .Title | default .Site.Title | plainify }}
# {{ $title }}

{{- with .Description }}
{{ . | plainify }}

{{- end -}}
{{- range .Pages }}
{{- $page := . -}}
{{- $link := $page.RelPermalink -}}
{{- with $page.OutputFormats.Get "Gemini" }}
  {{- $link = .RelPermalink -}}
{{- end }}
=> {{ $link }} {{ $page.Title }}
{{ with $page.Date }}
    {{ .Format ($.Site.Params.date_format | default "Jan 2, 2006") }}
{{ end }}
{{- with $page.Params.description }}{{ . | plainify }}
{{- else }}{{ with $page.Summary }}{{ . | plainify }}{{ end }}
{{- end }}

{{- end -}}

{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $webURL = printf "%s%s" .Site.BaseURL .RelPermalink -}}
{{- end -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
=> {{ $webURL }} Web version

