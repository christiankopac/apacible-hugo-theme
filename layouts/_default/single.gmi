{{- $title := .Title | default "Untitled" | plainify }}
# {{ $title }}

{{- with .Date }}
Published {{ .Format "2006-01-02" }}{{ with $.Lastmod }}{{ if ne . $.Date }} · Updated {{ .Format "2006-01-02" }}{{ end }}{{ end }}

{{- end }}
{{- with .Description }}
{{ printf "%s\n\n" (. | plainify) }}
{{- end }}
{{ partial "gemini/content.gmi" . }}

{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $webURL = printf "%s%s" .Site.BaseURL .RelPermalink -}}
{{- end -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
=> {{ $webURL }} Web version

