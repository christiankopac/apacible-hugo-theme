{{- $title := .Title | default .Site.Title | plainify }}
# {{ $title }}

{{- with .Description }}
{{ . | plainify }}

{{- end }}
{{- $body := partial "gemini/content.gmi" . }}
{{- if $body }}
{{ $body }}
{{- end }}
{{- if .Pages }}
## Pages
{{- range .Pages }}
  {{- $page := . -}}
  {{- $link := $page.RelPermalink -}}
  {{- with $page.OutputFormats.Get "Gemini" }}
    {{- $link = .RelPermalink -}}
  {{- end }}
=> {{ $link }} {{ $page.Title }}
{{- with $page.Params.description }}    {{ . | plainify }}{{ end }}

{{- end -}}
{{- end -}}
{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $webURL = printf "%s%s" .Site.BaseURL .RelPermalink -}}
{{- end -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
=> {{ $webURL }} Web version

