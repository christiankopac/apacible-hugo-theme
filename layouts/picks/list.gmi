{{- $pageTitle := .Title | default .Site.Title | plainify }}
# {{ $pageTitle }}

{{- with .Description }}
{{ printf "%s\n\n" (. | plainify) }}
{{- end }}
{{- /* Get picks (top 6 items with rating >= 4.0) - current language */ -}}
{{- $currentLang := .Language.Lang | default "en" -}}
{{- $consumedPages := slice -}}
{{- range hugo.Sites -}}
  {{- $consumedPages = $consumedPages | append (where .RegularPages "Section" "consumed") -}}
{{- end -}}
{{- $moviePages := slice -}}
{{- $musicPages := slice -}}
{{- $bookPages := slice -}}
{{- range $consumedPages -}}
  {{- /* Only include pages in current language */ -}}
  {{- $isCurrentLang := or (in .File.Path (printf "content/%s/" $currentLang)) (in .File.Dir (printf "%s/" $currentLang)) (eq .Language.Lang $currentLang) -}}
  {{- if and (not .IsSection) $isCurrentLang -}}
    {{- if (in .File.Dir "movie/") -}}
    {{- $moviePages = $moviePages | append . -}}
    {{- else if (in .File.Dir "music/") -}}
    {{- $musicPages = $musicPages | append . -}}
    {{- else if (in .File.Dir "book/") -}}
    {{- $bookPages = $bookPages | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $movies := slice -}}
{{- $music := slice -}}
{{- $books := slice -}}
{{- range $moviePages -}}
  {{- if not .Draft -}}
    {{- $movies = $movies | append (dict 
      "title" (.Params.title | default .Title)
      "category" "movies"
      "year" (.Params.year | default "")
      "director" (.Params.director | default "")
      "rating" (.Params.rating | default 0)
      "content" (.Params.content | default "")
      "date_read" (.Params.date_read | default "")
      "footer" (.Params.footer | default "")
      "link" (.RelPermalink | default "")
      "page" .
    ) -}}
  {{- end -}}
{{- end -}}
{{- range $musicPages -}}
  {{- if not .Draft -}}
    {{- $music = $music | append (dict 
      "title" (.Params.title | default .Title)
      "category" "music"
      "year" (.Params.year | default "")
      "artist" (.Params.artist | default "")
      "rating" (.Params.rating | default 0)
      "content" (.Params.content | default "")
      "date_read" (.Params.date_read | default "")
      "footer" (.Params.footer | default "")
      "link" (.RelPermalink | default "")
      "page" .
    ) -}}
  {{- end -}}
{{- end -}}
{{- range $bookPages -}}
  {{- if not .Draft -}}
    {{- $books = $books | append (dict 
      "title" (.Params.title | default .Title)
      "category" "books"
      "year" (.Params.year | default "")
      "author" (.Params.author | default "")
      "rating" (.Params.rating | default 0)
      "content" (.Params.content | default "")
      "date_read" (.Params.date_read | default "")
      "footer" (.Params.footer | default "")
      "link" (.RelPermalink | default "")
      "page" .
    ) -}}
  {{- end -}}
{{- end -}}
{{- $picks := slice -}}
{{- range $movies -}}
  {{- $ratingValue := float (.rating | default 0) -}}
  {{- if ge $ratingValue 4.0 -}}
    {{- $sortDate := "" -}}
    {{- if .date_read -}}
      {{- $sortDate = .date_read -}}
    {{- else if .footer -}}
      {{- $sortDate = .footer -}}
    {{- end -}}
    {{- $picks = $picks | append (dict "item" . "sortDate" $sortDate) -}}
  {{- end -}}
{{- end -}}
{{- range $music -}}
  {{- $ratingValue := float (.rating | default 0) -}}
  {{- if ge $ratingValue 4.0 -}}
    {{- $sortDate := "" -}}
    {{- if .date_read -}}
      {{- $sortDate = .date_read -}}
    {{- else if .footer -}}
      {{- $sortDate = .footer -}}
    {{- end -}}
    {{- $picks = $picks | append (dict "item" . "sortDate" $sortDate) -}}
  {{- end -}}
{{- end -}}
{{- range $books -}}
  {{- $ratingValue := float (.rating | default 0) -}}
  {{- if ge $ratingValue 4.0 -}}
    {{- $sortDate := "" -}}
    {{- if .date_read -}}
      {{- $sortDate = .date_read -}}
    {{- else if .footer -}}
      {{- $sortDate = .footer -}}
    {{- end -}}
    {{- $picks = $picks | append (dict "item" . "sortDate" $sortDate) -}}
  {{- end -}}
{{- end -}}
{{- $sortedPicks := sort $picks "sortDate" "desc" -}}
{{- $recentPicks := first 6 $sortedPicks -}}
{{- if gt (len $recentPicks) 0 }}
{{- range $recentPicks }}
{{- $item := .item }}
{{- $title := $item.title | default "Untitled" }}
{{- $link := $item.link }}
{{- $page := $item.page }}
{{- if $page }}
  {{- $geminiLink := $page.RelPermalink }}
  {{- with $page.OutputFormats.Get "Gemini" }}
    {{- $geminiLink = .RelPermalink }}
  {{- end }}
  {{- $link = $geminiLink }}
{{- end }}
{{- $details := slice }}
{{- if eq $item.category "movies" }}
  {{- with $item.director }}
    {{- $details = $details | append (printf "Director: %s" .) }}
  {{- end }}
{{- else if eq $item.category "music" }}
  {{- with $item.artist }}
    {{- $details = $details | append (printf "Artist: %s" .) }}
  {{- end }}
{{- else if eq $item.category "books" }}
  {{- with $item.author }}
    {{- $details = $details | append (printf "Author: %s" .) }}
  {{- end }}
{{- end }}
{{- with $item.year }}
  {{- $details = $details | append (printf "Year: %s" .) }}
{{- end }}
{{- with $item.rating }}
  {{- $details = $details | append (printf "Rating: %v/5" .) }}
{{- end }}
{{- if $link }}
=> {{ $link }} {{ $title | plainify }}
{{- else }}
### {{ $title | plainify }}
{{- end }}
{{- range $details }}
* {{ . }}
{{- end }}
{{- with $item.content }}
{{- $summary := strings.TrimSpace (. | plainify) }}
{{- /* Remove markdown formatting */ -}}
{{- $summary = replaceRE `\*\*([^*]+)\*\*` "$1" $summary -}}
{{- $summary = replaceRE `\*([^*]+)\*` "$1" $summary -}}
{{- $summary = replaceRE `__([^_]+)__` "$1" $summary -}}
{{- $summary = replaceRE `_([^_]+)_` "$1" $summary -}}
{{- $summary = replaceRE `~~([^~]+)~~` "$1" $summary -}}
{{- $summary = replaceRE `\*\*` "" $summary -}}
{{- $summary = replaceRE `__` "" $summary -}}
{{- $summary = replaceRE `\*` "" $summary -}}
{{- $summary = replaceRE `_` "" $summary -}}
{{- $summary = replaceRE `~~` "" $summary -}}
{{- if ne $summary "" }}
{{ $summary }}
{{- end }}
{{- end }}

{{- end }}
{{- else }}
No picks yet.
{{- end }}

{{- /* Link to consumed section */ -}}
{{- $consumedPage := .Site.GetPage "/consumed" -}}
{{- if $consumedPage -}}
  {{- $consumedLink := $consumedPage.RelPermalink -}}
  {{- with $consumedPage.OutputFormats.Get "Gemini" -}}
    {{- $consumedLink = .RelPermalink -}}
  {{- end -}}
{{ printf "\n=> %s View all consumed content\n" $consumedLink }}
{{- end -}}
{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $siteURL := .Site.Params.site_url | default .Site.BaseURL -}}
  {{- $webURL = printf "%s%s" $siteURL .RelPermalink -}}
{{- end -}}
{{- $geminiURL := .Site.Params.gemini_url | default "gemini://gemini.kopac.ch" -}}
{{- $siteURL := .Site.Params.site_url | default .Site.BaseURL -}}
{{- $webURL = replace $webURL $geminiURL $siteURL -}}
{{- $webURL = replace $webURL (printf "https://%s" (strings.TrimPrefix "gemini://" $geminiURL)) $siteURL -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
{{ printf "\n=> %s Web version\n" $webURL }}

