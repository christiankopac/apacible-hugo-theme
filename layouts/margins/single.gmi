{{- /* Get English version for metadata (if viewing translation) */ -}}
{{- $englishPage := . -}}
{{- if ne .Language.Lang "en" -}}
  {{- /* Try to find English version through translations */ -}}
  {{- range .Translations -}}
    {{- if eq .Language.Lang "en" -}}
      {{- $englishPage = . -}}
      {{- break -}}
    {{- end -}}
  {{- end -}}
  {{- /* If not found in translations, try to get by path */ -}}
  {{- if eq $englishPage.Language.Lang .Language.Lang -}}
    {{- $enPath := replace .File.Path "content/es/" "content/en/" -}}
    {{- $enPage := .Site.GetPage $enPath -}}
    {{- if $enPage -}}
      {{- $englishPage = $enPage -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Get metadata from English page params, but title from current page (for translation) */ -}}
{{- $mediaData := dict
    "title" (.Params.title | default .Title)
    "year" ($englishPage.Params.year | default "")
    "director" ($englishPage.Params.director | default "")
    "author" ($englishPage.Params.author | default "")
    "artist" ($englishPage.Params.artist | default "")
    "publisher" ($englishPage.Params.publisher | default "")
    "label" ($englishPage.Params.label | default "")
    "rating" ($englishPage.Params.rating | default 0)
    "content" (.Params.content | default "")
    "review" (.Params.review | default "")
    "genre" ($englishPage.Params.genre | default "")
    "genres" ($englishPage.Params.genres | default slice)
    "style" ($englishPage.Params.style | default "")
    "category" ($englishPage.Params.category | default "")
-}}
{{- $isMovie := eq $mediaData.category "movie" -}}
{{- $isBook := eq $mediaData.category "book" -}}
{{- $isMusic := eq $mediaData.category "music" -}}

{{- /* Title */ -}}
{{- if $isMusic -}}
  {{- if and $mediaData.artist $mediaData.title -}}
    {{- printf "# %s - %s\n\n" ($mediaData.artist | plainify) ($mediaData.title | plainify) -}}
  {{- else -}}
    {{- printf "# %s\n\n" ($mediaData.title | plainify) -}}
  {{- end -}}
{{- else if $isMovie -}}
  {{- printf "# %s" ($mediaData.title | plainify) -}}
  {{- with $mediaData.year -}}
    {{- printf " (%s)" . -}}
  {{- end -}}
  {{- printf "\n\n" -}}
{{- else -}}
  {{- printf "# %s\n\n" ($mediaData.title | plainify) -}}
{{- end -}}

{{- /* Subtitle */ -}}
{{- if $isBook -}}
  {{- with $mediaData.author -}}
    {{- printf "%s %s\n\n" (i18n "by" | default "by") (. | plainify) -}}
  {{- end -}}
{{- else if $isMovie -}}
  {{- with $mediaData.director -}}
    {{- printf "%s %s\n\n" (i18n "directedBy" | default "Directed by") (. | plainify) -}}
  {{- end -}}
{{- end -}}

{{- /* Metadata */ -}}
{{- if not $isMovie -}}
  {{- with $mediaData.year -}}
    {{- printf "* %s: %s\n" (i18n "year" | default "Year") . -}}
  {{- end -}}
{{- end -}}

{{- with $mediaData.rating -}}
  {{- $rating := float . -}}
  {{- if gt $rating 0 -}}
    {{- $fullStars := int (math.Floor $rating) -}}
    {{- $ratingTimes2 := mul $rating 2.0 -}}
    {{- $ratingTimes2Int := int $ratingTimes2 -}}
    {{- $hasHalf := ne (mod $ratingTimes2Int 2) 0 -}}
    {{- $emptyStars := sub 5 (add $fullStars (cond $hasHalf 1 0)) -}}
    {{- $stars := "" -}}
    {{- range seq $fullStars -}}
      {{- $stars = printf "%s★" $stars -}}
    {{- end -}}
    {{- if $hasHalf -}}
      {{- $stars = printf "%s⯪" $stars -}}
    {{- end -}}
    {{- range seq $emptyStars -}}
      {{- $stars = printf "%s☆" $stars -}}
    {{- end -}}
    {{- printf "* %s: %s\n" (i18n "rating" | default "Rating") $stars -}}
  {{- end -}}
{{- end -}}

{{- if $isBook -}}
  {{- with $mediaData.publisher -}}
    {{- printf "* %s: %s\n" (i18n "publisher" | default "Publisher") (. | plainify) -}}
  {{- end -}}
  {{- $genresToShow := $mediaData.genres -}}
  {{- if and (eq (len $genresToShow) 0) (ne $mediaData.genre "") -}}
    {{- $genresToShow = slice $mediaData.genre -}}
  {{- end -}}
  {{- if gt (len $genresToShow) 0 -}}
    {{- printf "* %s: %s\n" (i18n "genre" | default "Genre") (delimit $genresToShow ", " | plainify) -}}
  {{- end -}}
{{- else if $isMusic -}}
  {{- with $mediaData.label -}}
    {{- printf "* %s: %s\n" (i18n "label" | default "Label") (. | plainify) -}}
  {{- end -}}
  {{- $genresToShow := $mediaData.genres -}}
  {{- if and (eq (len $genresToShow) 0) (ne $mediaData.genre "") -}}
    {{- $genresToShow = slice $mediaData.genre -}}
  {{- end -}}
  {{- if gt (len $genresToShow) 0 -}}
    {{- printf "* %s: %s\n" (i18n "genre" | default "Genre") (delimit $genresToShow ", " | plainify) -}}
  {{- end -}}
{{- else if $isMovie -}}
  {{- $genresToShow := $mediaData.genres -}}
  {{- if and (eq (len $genresToShow) 0) (ne $mediaData.genre "") -}}
    {{- $genresToShow = slice $mediaData.genre -}}
  {{- end -}}
  {{- if gt (len $genresToShow) 0 -}}
    {{- printf "* %s: %s\n" (i18n "genre" | default "Genre") (delimit $genresToShow ", " | plainify) -}}
  {{- end -}}
{{- end -}}

{{- /* Consumed date: format page date as "Mon YYYY" with category verb */ -}}
{{- $consumedDate := $englishPage.Date.Format "Jan 2006" -}}
{{- if $consumedDate -}}
  {{- /* Get translated verb based on category - use as label */ -}}
  {{- $verbLabel := "" -}}
  {{- if $isBook -}}
    {{- $verbLabel = i18n "read" | default "Read" -}}
  {{- else if $isMusic -}}
    {{- $verbLabel = i18n "listened" | default "Listened" -}}
  {{- else if $isMovie -}}
    {{- $verbLabel = i18n "watched" | default "Watched" -}}
  {{- end -}}
  {{- printf "* %s: %s\n" $verbLabel $consumedDate -}}
{{- end -}}

{{- printf "\n" -}}

{{- /* Content - exclude images */ -}}
{{- with $mediaData.content -}}
  {{- $content := . | plainify -}}
  {{- /* Remove markdown image syntax */ -}}
  {{- $content = replaceRE `!\[([^\]]*)\]\([^)]+\)` "" $content -}}
  {{- $content = replaceRE `\*\*([^*]+)\*\*` "$1" $content -}}
  {{- $content = replaceRE `\*([^*]+)\*` "$1" $content -}}
  {{- $content = replaceRE `__([^_]+)__` "$1" $content -}}
  {{- $content = replaceRE `_([^_]+)_` "$1" $content -}}
  {{- $content = replaceRE `~~([^~]+)~~` "$1" $content -}}
  {{- $content = strings.TrimSpace $content -}}
  {{- if ne $content "" -}}
    {{- printf "%s\n\n" $content -}}
  {{- end -}}
{{- end -}}

{{- with $mediaData.review -}}
  {{- printf "## Review\n\n" -}}
  {{- $review := . | plainify -}}
  {{- /* Remove markdown image syntax */ -}}
  {{- $review = replaceRE `!\[([^\]]*)\]\([^)]+\)` "" $review -}}
  {{- $review = replaceRE `\*\*([^*]+)\*\*` "$1" $review -}}
  {{- $review = replaceRE `\*([^*]+)\*` "$1" $review -}}
  {{- $review = replaceRE `__([^_]+)__` "$1" $review -}}
  {{- $review = replaceRE `_([^_]+)_` "$1" $review -}}
  {{- $review = replaceRE `~~([^~]+)~~` "$1" $review -}}
  {{- $review = strings.TrimSpace $review -}}
  {{- if ne $review "" -}}
    {{- printf "%s\n\n" $review -}}
  {{- end -}}
{{- end -}}

{{- /* Page content - exclude images */ -}}
{{- if .Content -}}
  {{- $pageContent := .Content | plainify -}}
  {{- /* Remove markdown image syntax */ -}}
  {{- $pageContent = replaceRE `!\[([^\]]*)\]\([^)]+\)` "" $pageContent -}}
  {{- $pageContent = replaceRE `\*\*([^*]+)\*\*` "$1" $pageContent -}}
  {{- $pageContent = replaceRE `\*([^*]+)\*` "$1" $pageContent -}}
  {{- $pageContent = replaceRE `__([^_]+)__` "$1" $pageContent -}}
  {{- $pageContent = replaceRE `_([^_]+)_` "$1" $pageContent -}}
  {{- $pageContent = replaceRE `~~([^~]+)~~` "$1" $pageContent -}}
  {{- $pageContent = strings.TrimSpace $pageContent -}}
  {{- if ne $pageContent "" -}}
    {{- printf "%s\n\n" $pageContent -}}
  {{- end -}}
{{- end -}}

{{- /* Web version link */ -}}
{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $siteURL := .Site.Params.site_url | default .Site.BaseURL -}}
  {{- $webURL = printf "%s%s" $siteURL $.RelPermalink -}}
{{- end -}}
{{- /* Map gemini:// links back to the web origin (params.gemini_url → params.site_url). */ -}}
{{- with .Site.Params.gemini_url -}}
  {{- $siteURL := $.Site.Params.site_url | default $.Site.BaseURL -}}
  {{- $webURL = replace $webURL . $siteURL -}}
  {{- $webURL = replace $webURL (printf "https://%s" (strings.TrimPrefix "gemini://" .)) $siteURL -}}
{{- end -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
=> {{ $webURL }} Web version

