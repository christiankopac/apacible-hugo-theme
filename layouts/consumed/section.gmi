{{- $title := .Title | default .Site.Title | plainify }}
# {{ $title }}

{{- with .Description }}
{{ . | plainify }}

{{- end }}
{{- $body := partial "gemini/content.gmi" . }}
{{- if $body }}
{{ $body }}
{{- end }}

{{- /* Get all consumed pages and organize by category - current language */ -}}
{{- $currentLang := .Language.Lang | default "en" -}}
{{- $consumedPages := where .Site.AllPages "Section" "consumed" -}}
{{- $moviePages := slice -}}
{{- $musicPages := slice -}}
{{- $bookPages := slice -}}
{{- range $consumedPages -}}
  {{- /* Only include pages in current language */ -}}
  {{- $isCurrentLang := or (in .File.Path (printf "content/%s/" $currentLang)) (in .File.Dir (printf "%s/" $currentLang)) (eq .Language.Lang $currentLang) -}}
  {{- if and (not .IsSection) $isCurrentLang -}}
    {{- if (in .File.Dir "movie/") -}}
      {{- $moviePages = $moviePages | append . -}}
    {{- else if (in .File.Dir "music/") -}}
      {{- $musicPages = $musicPages | append . -}}
    {{- else if (in .File.Dir "book/") -}}
      {{- $bookPages = $bookPages | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Books Section */ -}}
{{- if gt (len $bookPages) 0 -}}
{{ printf "## Books\n\n" }}
{{- range $bookPages -}}
  {{- if not .Draft -}}
    {{- /* Get English version for metadata */ -}}
    {{- $englishPage := . -}}
    {{- if ne .Language.Lang "en" -}}
      {{- range .Translations -}}
        {{- if eq .Language.Lang "en" -}}
          {{- $englishPage = . -}}
          {{- break -}}
        {{- end -}}
      {{- end -}}
      {{- if eq $englishPage.Language.Lang .Language.Lang -}}
        {{- $enPath := replace .File.Path "content/es/" "content/en/" -}}
        {{- $enPage := $.Site.GetPage $enPath -}}
        {{- if $enPage -}}
          {{- $englishPage = $enPage -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $link := .RelPermalink -}}
    {{- with .OutputFormats.Get "Gemini" -}}
      {{- $link = .RelPermalink -}}
    {{- end -}}
    {{- $title := .Params.title | default .Title | plainify -}}
    {{- $author := $englishPage.Params.author | default "" -}}
    {{- $year := $englishPage.Params.year | default "" -}}
    {{- $rating := $englishPage.Params.rating | default 0 -}}
    {{- $output := printf "=> %s %s\n" $link $title -}}
    {{- if $author -}}
      {{- $output = printf "%s    Author: %s\n" $output ($author | plainify) -}}
    {{- end -}}
    {{- if $year -}}
      {{- $output = printf "%s    Year: %s\n" $output $year -}}
    {{- end -}}
    {{- if and $rating (gt (float $rating) 0) -}}
      {{- $output = printf "%s    Rating: %v/5\n" $output $rating -}}
    {{- end -}}
    {{- $output = printf "%s\n" $output -}}
{{ $output }}
  {{- end -}}
{{- end -}}
{{- end -}}

{{- /* Movies Section */ -}}
{{- if gt (len $moviePages) 0 -}}
{{ printf "## Movies\n\n" }}
{{- range $moviePages -}}
  {{- if not .Draft -}}
    {{- /* Get English version for metadata */ -}}
    {{- $englishPage := . -}}
    {{- if ne .Language.Lang "en" -}}
      {{- range .Translations -}}
        {{- if eq .Language.Lang "en" -}}
          {{- $englishPage = . -}}
          {{- break -}}
        {{- end -}}
      {{- end -}}
      {{- if eq $englishPage.Language.Lang .Language.Lang -}}
        {{- $enPath := replace .File.Path "content/es/" "content/en/" -}}
        {{- $enPage := $.Site.GetPage $enPath -}}
        {{- if $enPage -}}
          {{- $englishPage = $enPage -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $link := .RelPermalink -}}
    {{- with .OutputFormats.Get "Gemini" -}}
      {{- $link = .RelPermalink -}}
    {{- end -}}
    {{- $title := .Params.title | default .Title | plainify -}}
    {{- $director := $englishPage.Params.director | default "" -}}
    {{- $year := $englishPage.Params.year | default "" -}}
    {{- $rating := $englishPage.Params.rating | default 0 -}}
    {{- $output := printf "=> %s %s\n" $link $title -}}
    {{- if $director -}}
      {{- $output = printf "%s    Director: %s\n" $output ($director | plainify) -}}
    {{- end -}}
    {{- if $year -}}
      {{- $output = printf "%s    Year: %s\n" $output $year -}}
    {{- end -}}
    {{- if and $rating (gt (float $rating) 0) -}}
      {{- $output = printf "%s    Rating: %v/5\n" $output $rating -}}
    {{- end -}}
    {{- $output = printf "%s\n" $output -}}
{{ $output }}
  {{- end -}}
{{- end -}}
{{- end -}}

{{- /* Music Section */ -}}
{{- if gt (len $musicPages) 0 -}}
{{ printf "## Music\n\n" }}
{{- range $musicPages -}}
  {{- if not .Draft -}}
    {{- /* Get English version for metadata */ -}}
    {{- $englishPage := . -}}
    {{- if ne .Language.Lang "en" -}}
      {{- range .Translations -}}
        {{- if eq .Language.Lang "en" -}}
          {{- $englishPage = . -}}
          {{- break -}}
        {{- end -}}
      {{- end -}}
      {{- if eq $englishPage.Language.Lang .Language.Lang -}}
        {{- $enPath := replace .File.Path "content/es/" "content/en/" -}}
        {{- $enPage := $.Site.GetPage $enPath -}}
        {{- if $enPage -}}
          {{- $englishPage = $enPage -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $link := .RelPermalink -}}
    {{- with .OutputFormats.Get "Gemini" -}}
      {{- $link = .RelPermalink -}}
    {{- end -}}
    {{- $title := .Params.title | default .Title | plainify -}}
    {{- $artist := $englishPage.Params.artist | default "" -}}
    {{- $year := $englishPage.Params.year | default "" -}}
    {{- $rating := $englishPage.Params.rating | default 0 -}}
    {{- $displayTitle := $title -}}
    {{- if and $artist $title -}}
      {{- $displayTitle = printf "%s - %s" ($artist | plainify) ($title | plainify) -}}
    {{- end -}}
    {{- $output := printf "=> %s %s\n" $link $displayTitle -}}
    {{- if $year -}}
      {{- $output = printf "%s    Year: %s\n" $output $year -}}
    {{- end -}}
    {{- if and $rating (gt (float $rating) 0) -}}
      {{- $output = printf "%s    Rating: %v/5\n" $output $rating -}}
    {{- end -}}
    {{- $output = printf "%s\n" $output -}}
{{ $output }}
  {{- end -}}
{{- end -}}
{{- end -}}

{{- /* Web version link */ -}}
{{- $webURL := "" -}}
{{- with .OutputFormats.Get "HTML" -}}
  {{- $webURL = .Permalink -}}
{{- else -}}
  {{- $siteURL := .Site.Params.site_url | default .Site.BaseURL -}}
  {{- $webURL = printf "%s%s" $siteURL .RelPermalink -}}
{{- end -}}
{{- $geminiURL := .Site.Params.gemini_url | default "gemini://gemini.kopac.ch" -}}
{{- $siteURL := .Site.Params.site_url | default .Site.BaseURL -}}
{{- $webURL = replace $webURL $geminiURL $siteURL -}}
{{- $webURL = replace $webURL (printf "https://%s" (strings.TrimPrefix "gemini://" $geminiURL)) $siteURL -}}
{{- $webURL = replace $webURL "gemini://" "https://" -}}
{{ printf "\n=> %s Web version\n" $webURL }}

